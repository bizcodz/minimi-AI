{
  "name": "minimi-ai",
  "version": "1.0.0",
  "description": "Conversational AI research agent with temporal memory and change detection",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c green,cyan \"node src/server.js\" \"next dev -p 3000\"",
    "dev:backend": "node src/server.js",
    "dev:frontend": "next dev -p 3000",
    "build": "next build",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/eval.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "next": "^14.2.23",
    "openai": "^4.83.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "vitest": "^2.1.8"
  }
}
